<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景层 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- 内容层 -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <layer-list>
            <!-- 顶部标题区域 -->
            <item android:height="24dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                </shape>
            </item>

            <!-- 模拟日期文字 -->
            <item
                android:height="16dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

            <!-- 模拟周数和更新时间 -->
            <item
                android:height="12dp"
                android:top="28dp">
                <layer-list>
                    <item android:width="40dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#CCFFFFFF" />
                            <corners android:radius="2dp" />
                        </shape>
                    </item>
                    <item
                        android:width="80dp"
                        android:left="100dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#CCFFFFFF" />
                            <corners android:radius="2dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- 模拟课程列表 -->
            <item android:top="48dp">
                <layer-list>
                    <!-- 第一个课程项 -->
                    <item
                        android:height="32dp"
                        android:bottom="4dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#20FFFFFF" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>

                    <!-- 第二个课程项 -->
                    <item
                        android:height="32dp"
                        android:bottom="4dp"
                        android:top="36dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#20FFFFFF" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>

                    <!-- 第三个课程项 -->
                    <item
                        android:height="32dp"
                        android:top="72dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#20FFFFFF" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </layer-list>
    </item>
</layer-list>
